# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alternative when a publishable key is unavailable:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_HUB_DEMO_ENABLED=false
# Server-only secrets, required by existing Library admin APIs.
SUPABASE_SERVICE_ROLE_KEY=your-server-secret
# Optional existing Library integrations:
ANTHROPIC_API_KEY=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
